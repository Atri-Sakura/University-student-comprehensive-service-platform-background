<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.OrderStatusLogMapper">

    <resultMap type="OrderStatusLog" id="OrderStatusLogResult">
        <result property="logId" column="log_id"/>
        <result property="orderMainId" column="order_main_id"/>
        <result property="oldStatus" column="old_status"/>
        <result property="newStatus" column="new_status"/>
        <result property="operatorType" column="operator_type"/>
        <result property="operatorId" column="operator_id"/>
        <result property="operatorName" column="operator_name"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 新增订单状态日志 -->
    <insert id="insertOrderStatusLog" parameterType="OrderStatusLog" useGeneratedKeys="true" keyProperty="logId">
        INSERT INTO order_status_log (
            order_main_id,
            old_status,
            new_status,
            operator_type,
            operator_id,
            operator_name,
            remark,
            create_time
        ) VALUES (
                     #{orderMainId},
                     #{oldStatus},
                     #{newStatus},
                     #{operatorType},
                     #{operatorId},
                     #{operatorName},
                     #{remark},
                     NOW()
                 )
    </insert>

    <!-- 查询订单状态日志列表 -->
    <select id="selectOrderStatusLogList" parameterType="OrderStatusLog" resultMap="OrderStatusLogResult">
        SELECT * FROM order_status_log
        <where>
            <if test="orderMainId != null">
                AND order_main_id = #{orderMainId}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

</mapper>