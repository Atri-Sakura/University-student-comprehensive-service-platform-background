<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.RiderWalletMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="RiderWalletResult" type="com.ruoyi.platform.domain.RiderWallet">
        <result property="riderWalletId" column="rider_wallet_id"/>
        <result property="riderBaseId"   column="rider_base_id"/>
        <result property="balance"       column="balance"/>
        <result property="freezeAmount"  column="freeze_amount"/>
        <result property="createTime"    column="create_time"/>
        <result property="updateTime"    column="update_time"/>
    </resultMap>

    <select id="selectRiderWalletByRiderBaseId" resultMap="RiderWalletResult">
        SELECT rider_wallet_id, rider_base_id, balance, freeze_amount, create_time, update_time
        FROM rider_wallet
        WHERE rider_base_id = #{riderBaseId}
    </select>

    <!--
        查询骑手钱包列表
        参数：riderWallet（可按条件筛选）
    -->
    <select id="selectRiderWalletList" parameterType="com.ruoyi.platform.domain.RiderWallet" resultMap="RiderWalletResult">
        SELECT rider_wallet_id, rider_base_id, balance, freeze_amount, create_time, update_time
        FROM rider_wallet
        <where>
            <if test="riderBaseId != null">
                AND rider_base_id = #{riderBaseId}
            </if>
            <if test="balance != null">
                AND balance = #{balance}
            </if>
            <if test="freezeAmount != null">
                AND freeze_amount = #{freezeAmount}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <!--
        新增骑手钱包
        参数：riderWallet
    -->
<!--    <insert id="insertRiderWallet" parameterType="com.ruoyi.platform.domain.RiderWallet" useGeneratedKeys="true" keyProperty="riderWalletId">-->
<!--        INSERT INTO rider_wallet (rider_base_id, balance, freeze_amount, create_time)-->
<!--        VALUES (#{riderBaseId}, #{balance}, #{freezeAmount}, NOW())-->
<!--    </insert>-->
    <insert id="insertRiderWallet"
            parameterType="com.ruoyi.platform.domain.RiderWallet">
        INSERT INTO rider_wallet (
            rider_wallet_id,
            rider_base_id,
            balance,
            freeze_amount,
            create_time
        )
        VALUES (
                   #{riderWalletId},
                   #{riderBaseId},
                   #{balance},
                   #{freezeAmount},
                   NOW()
               )
    </insert>

    <!--
        修改骑手钱包
        参数：riderWallet
    -->
    <update id="updateRiderWallet" parameterType="com.ruoyi.platform.domain.RiderWallet">
        UPDATE rider_wallet
        <set>
            <if test="balance != null">balance = #{balance},</if>
            <if test="freezeAmount != null">freeze_amount = #{freezeAmount},</if>
            update_time = NOW()
        </set>
        WHERE rider_wallet_id = #{riderWalletId}
    </update>

    <!--
        批量删除骑手钱包
        参数：riderWalletIds (Long[])
    -->
    <delete id="deleteRiderWalletByRiderWalletIds" parameterType="long">
        DELETE FROM rider_wallet
        WHERE rider_wallet_id IN
        <foreach collection="riderWalletIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!--
        删除单个骑手钱包
        参数：riderWalletId
    -->
    <delete id="deleteRiderWalletByRiderWalletId" parameterType="long">
        DELETE FROM rider_wallet WHERE rider_wallet_id = #{riderWalletId}
    </delete>

    <!-- 补充 RiderWalletMapper.xml 中的方法 -->
    <!-- 增加骑手余额 -->
    <update id="increaseBalance">
        UPDATE rider_wallet
        SET balance = balance + #{amount},
            update_time = NOW()
        WHERE rider_base_id = #{riderId}
    </update>
</mapper>