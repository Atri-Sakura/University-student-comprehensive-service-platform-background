</select>

<select id="selectErrandOrderMainWithDetailsByOrderNo" parameterType="String" resultMap="ErrandOrderMainResultWithDetails">
    SELECT
    om.*,
    oed.order_errand_detail_id,
    oed.errand_type,
    oed.goods_desc,
    oed.expected_time,
    oed.advance_amount,
    oed.tip_amount,
    oed.buy_photo_url,
    od.rider_id,
    od.delivery_status,
    od.receive_time,
    od.pick_time,
    od.deliver_time,
    od.delivery_fee,
    od.rider_income,
    rb.nickname AS rider_nickname,
    rb. phone AS rider_phone,
    rb.avatar AS rider_avatar,
    rb.real_name AS rider_real_name,
    rb.work_status AS rider_work_status,
    rb. credit_score AS rider_credit_score
    FROM order_main om
    LEFT JOIN order_errand_detail oed ON om.order_main_id = oed.order_main_id
    LEFT JOIN order_delivery od ON om.order_main_id = od.order_main_id
    LEFT JOIN rider_base rb ON od.rider_id = rb.rider_base_id
    WHERE om.order_no = #{orderNo}
    AND om.order_type = 2
</select>

<select id="selectErrandOrderMainListWithDetails" parameterType="OrderMain" resultMap="ErrandOrderMainResultWithDetails">
    SELECT
    om.*,
    oed.order_errand_detail_id,
    oed. errand_type,
    oed.goods_desc,
    oed.expected_time,
    oed.advance_amount,
    oed.tip_amount,
    oed.buy_photo_url,
    od. rider_id,
    od. delivery_status,
    od. receive_time,
    od. pick_time,
    od. deliver_time,
    od. delivery_fee,
    od. rider_income,
    rb. nickname AS rider_nickname,
    rb.phone AS rider_phone,
    rb.avatar AS rider_avatar,
    rb.real_name AS rider_real_name,
    rb.work_status AS rider_work_status,
    rb.credit_score AS rider_credit_score
    FROM order_main om
    LEFT JOIN order_errand_detail oed ON om.order_main_id = oed.order_main_id
    LEFT JOIN order_delivery od ON om.order_main_id = od.order_main_id
    LEFT JOIN rider_base rb ON od.rider_id = rb. rider_base_id
    WHERE om.order_type = 2
    <if test="orderNo != null and orderNo != ''">
        AND om.order_no LIKE CONCAT('%', #{orderNo}, '%')
    </if>
    <if test="userId != null">
        AND om.user_id = #{userId}
    </if>
    <if test="orderStatus != null">
        AND om. order_status = #{orderStatus}
    </if>
    <if test="merchantId != null">
        AND om.merchant_id = #{merchantId}
    </if>
    <if test="riderId != null">
        AND od.rider_id = #{riderId}
    </if>
    <if test="beginTime != null and beginTime != ''">
        AND om.create_time >= #{beginTime}
    </if>
    ORDER BY om.create_time DESC
</select>

