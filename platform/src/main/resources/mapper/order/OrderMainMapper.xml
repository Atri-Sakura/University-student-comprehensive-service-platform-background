    <!-- ============================================================================================================= -->
    <!-- 获取今日收入 -->
    <select id="selectMerchantTodayIncome" parameterType="map" resultType="java.util.Map">
        SELECT
            COALESCE(SUM(o.pay_amount), 0) AS total_income,
            COUNT(DISTINCT o.order_main_id) AS order_count
        FROM order_main o
                 JOIN order_takeout_detail d ON o.order_main_id = d.order_main_id
        WHERE d.merchant_id = #{merchantId}
          AND o.pay_status = 1
          AND o.order_status = 4
          AND o.complete_time BETWEEN #{startTime} AND #{endTime}
    </select>

    <!-- ============================================================================================================== -->
    <!-- 获取今日退款 -->
    <select id="selectMerchantTodayRefund" parameterType="map" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(o.pay_amount), 0)
        FROM order_main o
                 JOIN order_takeout_detail d ON o.order_main_id = d.order_main_id
        WHERE d.merchant_id = #{merchantId}
          AND o.pay_status IN (2, 3)
          AND o.complete_time BETWEEN #{startTime} AND #{endTime}
    </select>


    <!-- ===============================
         二手交易订单插入方法
         =============================== -->
    <insert id="insertSecondhandOrderMain" parameterType="com.ruoyi.platform.domain.OrderMain"
            useGeneratedKeys="false">

        INSERT INTO order_main (
            order_main_id,
            order_no,
            user_id,
            user_nickname,
            order_type,
            total_amount,
            pay_amount,
            pay_type,
            pay_status,
            order_status,
            pick_address_id,
            pick_address,
            pick_contact,
            pick_phone,
            deliver_address,
            deliver_contact,
            deliver_phone,
            remark,
            create_time,
            update_time
        ) VALUES (
                     #{orderMainId},
                     #{orderNo},
                     #{userId},
                     #{userNickname},
                     #{orderType},
                     #{totalAmount},
                     #{payAmount},
                     #{payType},
                     #{payStatus},
                     #{orderStatus},

                     #{pickAddressId},
                     #{pickAddress},
                     #{pickContact},
                     #{pickPhone},

                     #{deliverAddress},
                     #{deliverContact},
                     #{deliverPhone},
                     #{remark},
                     NOW(),
                     NOW()
                 )

    </insert>
    <!-- 查询二手订单 -->
    <select id="selectOrderByOrderNo" parameterType="string" resultMap="OrderMainResult">
        SELECT * FROM order_main WHERE order_no = #{orderNo}
    </select>

    <!-- 支付成功后更新 -->
    <update id="updatePayStatus">
        UPDATE order_main
        SET pay_status = #{payStatus},
            order_status = #{orderStatus},
            pay_time = #{payTime},
            update_time = NOW()
        WHERE order_no = #{orderNo}
    </update>

    <!-- 支付失败更新（订单失效） -->
    <update id="updateOrderStatus">
        UPDATE order_main
        SET order_status = #{orderStatus},
            pay_status = #{payStatus},
            cancel_reason = #{cancelReason},
            update_time = NOW()
        WHERE order_no = #{orderNo}
    </update>

    <update id="updateOrderComplete">
        UPDATE order_main
        SET order_status = 4,
            complete_time = #{completeTime},
            update_time = NOW()
        WHERE order_no = #{orderNo}
    </update>

