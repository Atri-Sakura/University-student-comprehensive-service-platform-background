    ) VALUES (
    #{orderMainId}, #{orderNo}, #{userId}, #{userNickname}, #{orderType}, #{totalAmount}, #{payAmount}, #{payType}, #{payStatus}, #{orderStatus}, #{pickAddressId}, #{pickAddress}, #{pickContact}, #{pickPhone}, #{deliverAddress}, #{deliverContact}, #{deliverPhone}, #{remark}, NOW(), NOW()
    )
</insert>

