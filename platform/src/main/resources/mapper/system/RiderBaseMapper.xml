<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.RiderBaseMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="RiderBaseResult" type="com.ruoyi.platform.domain.RiderBase">
        <id     property="riderBaseId"    column="rider_base_id"/>
        <result property="username"       column="username"/>
        <result property="password"       column="password"/>
        <result property="nickname"       column="nickname"/>
        <result property="avatar"         column="avatar"/>
        <result property="realName"       column="real_name"/>
        <result property="idCard"         column="id_card"/>
        <result property="idCardFront"    column="id_card_front"/>
        <result property="idCardBack"     column="id_card_back"/>
        <result property="phone"          column="phone"/>
        <result property="auditStatus"    column="audit_status"/>
        <result property="workStatus"     column="work_status"/>
        <result property="creditScore"    column="credit_score"/>
        <result property="accountStatus"  column="account_status"/>
        <result property="createTime"     column="create_time"/>
        <result property="updateTime"     column="update_time"/>
    </resultMap>

    <!-- ========== 查询语句 ========== -->

    <!-- 查询单个骑手信息 -->
    <select id="selectRiderBaseByRiderBaseId" parameterType="java.lang.Long" resultMap="RiderBaseResult">
        SELECT
            rider_base_id,
            username,
            password,
            nickname,
            avatar,
            real_name,
            id_card,
            id_card_front,
            id_card_back,
            phone,
            audit_status,
            work_status,
            credit_score,
            account_status,
            create_time,
            update_time
        FROM rider_base
        WHERE rider_base_id = #{riderBaseId}
    </select>

    <!-- 查询列表 -->
    <select id="selectRiderBaseList" parameterType="com.ruoyi.platform.domain.RiderBase" resultMap="RiderBaseResult">
        SELECT
        rider_base_id,
        username,
        password,
        nickname,
        avatar,
        real_name,
        id_card,
        id_card_front,
        id_card_back,
        phone,
        audit_status,
        work_status,
        credit_score,
        account_status,
        create_time,
        update_time
        FROM rider_base
        <where>
            <if test="username != null and username != ''">
                AND username LIKE concat('%', #{username}, '%')
            </if>
            <if test="phone != null and phone != ''">
                AND phone = #{phone}
            </if>
            <if test="workStatus != null">
                AND work_status = #{workStatus}
            </if>
        </where>
    </select>

    <!-- 修改骑手基本信息（仅限用户名、昵称、手机号） -->
    <update id="updateRiderBaseBasicInfo" parameterType="com.ruoyi.platform.domain.RiderBase">
        UPDATE rider_base
        <set>
            <if test="username != null and username != ''">
                username = #{username},
            </if>
            <if test="nickname != null and nickname != ''">
                nickname = #{nickname},
            </if>
            <if test="phone != null and phone != ''">
                phone = #{phone},
            </if>
            update_time = NOW()
        </set>
        WHERE rider_base_id = #{riderBaseId}
    </update>

    <!-- 修改骑手工作状态 -->
    <update id="updateRiderWorkStatus" parameterType="com.ruoyi.platform.domain.RiderBase">
        UPDATE rider_base
        SET work_status = #{workStatus},
            update_time = NOW()
        WHERE rider_base_id = #{riderBaseId}
    </update>

    <update id="updateRiderAuthInfo" parameterType="com.ruoyi.platform.domain.RiderBase">
        UPDATE rider_base
        SET real_name = #{realName},
            id_card = #{idCard},
            id_card_front = #{idCardFront},
            id_card_back = #{idCardBack},
            audit_status = #{auditStatus},
            update_time = NOW()
        WHERE rider_base_id = #{riderBaseId}
    </update>

</mapper>