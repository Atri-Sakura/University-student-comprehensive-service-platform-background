<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MerchantGoodsMapper">
    
    <resultMap type="MerchantGoods" id="MerchantGoodsResult">
        <result property="merchantGoodsId"    column="merchant_goods_id"    />
        <result property="merchantBaseId"    column="merchant_base_id"    />
        <result property="goodsName"    column="goods_name"    />
        <result property="category"    column="category"    />
        <result property="subCategory"    column="sub_category"    />
        <result property="price"    column="price"    />
        <result property="originalPrice"    column="original_price"    />
        <result property="stock"    column="stock"    />
        <result property="salesCount"    column="sales_count"    />
        <result property="description"    column="description"    />
        <result property="tagCodes"    column="tag_codes"    />
        <result property="status"    column="status"    />
        <result property="avgRating"    column="avg_rating"    />
        <result property="ratingCount"    column="rating_count"    />
        <result property="fiveStarRate"    column="five_star_rate"    />
        <result property="fourStarRate"    column="four_star_rate"    />
        <result property="threeStarRate"    column="three_star_rate"    />
        <result property="twoStarRate"    column="two_star_rate"    />
        <result property="oneStarRate"    column="one_star_rate"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectMerchantGoodsVo">
        select merchant_goods_id, merchant_base_id, goods_name, category, sub_category, price, original_price, stock, sales_count, description, tag_codes, status, avg_rating, rating_count, five_star_rate, four_star_rate, three_star_rate, two_star_rate, one_star_rate, create_time, update_time from merchant_goods
    </sql>

    <select id="selectMerchantGoodsList" parameterType="MerchantGoods" resultMap="MerchantGoodsResult">
        <include refid="selectMerchantGoodsVo"/>
        <where>  
            <if test="merchantBaseId != null "> and merchant_base_id = #{merchantBaseId}</if>
            <if test="goodsName != null  and goodsName != ''"> and goods_name like concat('%', #{goodsName}, '%')</if>
            <if test="category != null  and category != ''"> and category = #{category}</if>
            <if test="subCategory != null  and subCategory != ''"> and sub_category = #{subCategory}</if>
            <if test="price != null "> and price = #{price}</if>
            <if test="originalPrice != null "> and original_price = #{originalPrice}</if>
            <if test="stock != null "> and stock = #{stock}</if>
            <if test="salesCount != null "> and sales_count = #{salesCount}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="tagCodes != null  and tagCodes != ''"> and tag_codes = #{tagCodes}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="avgRating != null "> and avg_rating = #{avgRating}</if>
            <if test="ratingCount != null "> and rating_count = #{ratingCount}</if>
            <if test="fiveStarRate != null "> and five_star_rate = #{fiveStarRate}</if>
            <if test="fourStarRate != null "> and four_star_rate = #{fourStarRate}</if>
            <if test="threeStarRate != null "> and three_star_rate = #{threeStarRate}</if>
            <if test="twoStarRate != null "> and two_star_rate = #{twoStarRate}</if>
            <if test="oneStarRate != null "> and one_star_rate = #{oneStarRate}</if>
        </where>
    </select>
    
    <select id="selectMerchantGoodsByMerchantGoodsId" parameterType="Long" resultMap="MerchantGoodsResult">
        <include refid="selectMerchantGoodsVo"/>
        where merchant_goods_id = #{merchantGoodsId}
    </select>

    <insert id="insertMerchantGoods" parameterType="MerchantGoods">
        insert into merchant_goods
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantGoodsId != null">merchant_goods_id,</if>
            <if test="merchantBaseId != null">merchant_base_id,</if>
            <if test="goodsName != null and goodsName != ''">goods_name,</if>
            <if test="category != null and category != ''">category,</if>
            <if test="subCategory != null">sub_category,</if>
            <if test="price != null">price,</if>
            <if test="originalPrice != null">original_price,</if>
            <if test="stock != null">stock,</if>
            <if test="salesCount != null">sales_count,</if>
            <if test="description != null">description,</if>
            <if test="tagCodes != null">tag_codes,</if>
            <if test="status != null">status,</if>
            <if test="avgRating != null">avg_rating,</if>
            <if test="ratingCount != null">rating_count,</if>
            <if test="fiveStarRate != null">five_star_rate,</if>
            <if test="fourStarRate != null">four_star_rate,</if>
            <if test="threeStarRate != null">three_star_rate,</if>
            <if test="twoStarRate != null">two_star_rate,</if>
            <if test="oneStarRate != null">one_star_rate,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantGoodsId != null">#{merchantGoodsId},</if>
            <if test="merchantBaseId != null">#{merchantBaseId},</if>
            <if test="goodsName != null and goodsName != ''">#{goodsName},</if>
            <if test="category != null and category != ''">#{category},</if>
            <if test="subCategory != null">#{subCategory},</if>
            <if test="price != null">#{price},</if>
            <if test="originalPrice != null">#{originalPrice},</if>
            <if test="stock != null">#{stock},</if>
            <if test="salesCount != null">#{salesCount},</if>
            <if test="description != null">#{description},</if>
            <if test="tagCodes != null">#{tagCodes},</if>
            <if test="status != null">#{status},</if>
            <if test="avgRating != null">#{avgRating},</if>
            <if test="ratingCount != null">#{ratingCount},</if>
            <if test="fiveStarRate != null">#{fiveStarRate},</if>
            <if test="fourStarRate != null">#{fourStarRate},</if>
            <if test="threeStarRate != null">#{threeStarRate},</if>
            <if test="twoStarRate != null">#{twoStarRate},</if>
            <if test="oneStarRate != null">#{oneStarRate},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateMerchantGoods" parameterType="MerchantGoods">
        update merchant_goods
        <trim prefix="SET" suffixOverrides=",">
            <if test="merchantBaseId != null">merchant_base_id = #{merchantBaseId},</if>
            <if test="goodsName != null and goodsName != ''">goods_name = #{goodsName},</if>
            <if test="category != null and category != ''">category = #{category},</if>
            <if test="subCategory != null">sub_category = #{subCategory},</if>
            <if test="price != null">price = #{price},</if>
            <if test="originalPrice != null">original_price = #{originalPrice},</if>
            <if test="stock != null">stock = #{stock},</if>
            <if test="salesCount != null">sales_count = #{salesCount},</if>
            <if test="description != null">description = #{description},</if>
            <if test="tagCodes != null">tag_codes = #{tagCodes},</if>
            <if test="status != null">status = #{status},</if>
            <if test="avgRating != null">avg_rating = #{avgRating},</if>
            <if test="ratingCount != null">rating_count = #{ratingCount},</if>
            <if test="fiveStarRate != null">five_star_rate = #{fiveStarRate},</if>
            <if test="fourStarRate != null">four_star_rate = #{fourStarRate},</if>
            <if test="threeStarRate != null">three_star_rate = #{threeStarRate},</if>
            <if test="twoStarRate != null">two_star_rate = #{twoStarRate},</if>
            <if test="oneStarRate != null">one_star_rate = #{oneStarRate},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where merchant_goods_id = #{merchantGoodsId}
    </update>

    <delete id="deleteMerchantGoodsByMerchantGoodsId" parameterType="Long">
        delete from merchant_goods where merchant_goods_id = #{merchantGoodsId}
    </delete>

    <delete id="deleteMerchantGoodsByMerchantGoodsIds" parameterType="String">
        delete from merchant_goods where merchant_goods_id in 
        <foreach item="merchantGoodsId" collection="array" open="(" separator="," close=")">
            #{merchantGoodsId}
        </foreach>
    </delete>
</mapper>