<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.MerchantGoodsImageMapper">
    
    <resultMap type="MerchantGoodsImage" id="MerchantGoodsImageResult">
        <result property="merchantGoodsImageId"    column="merchant_goods_image_id"    />
        <result property="merchantGoodsId"    column="merchant_goods_id"    />
        <result property="imageUrl"    column="image_url"    />
        <result property="imageDesc"    column="image_desc"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="isMain"    column="is_main"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectMerchantGoodsImageVo">
        select merchant_goods_image_id, merchant_goods_id, image_url, image_desc, sort_order, is_main, create_time, update_time from merchant_goods_image
    </sql>

    <select id="selectMerchantGoodsImageList" parameterType="MerchantGoodsImage" resultMap="MerchantGoodsImageResult">
        <include refid="selectMerchantGoodsImageVo"/>
        <where>  
            <if test="merchantGoodsId != null "> and merchant_goods_id = #{merchantGoodsId}</if>
            <if test="imageUrl != null  and imageUrl != ''"> and image_url = #{imageUrl}</if>
            <if test="imageDesc != null  and imageDesc != ''"> and image_desc = #{imageDesc}</if>
            <if test="sortOrder != null "> and sort_order = #{sortOrder}</if>
            <if test="isMain != null "> and is_main = #{isMain}</if>
        </where>
    </select>
    
    <select id="selectMerchantGoodsImageByMerchantGoodsImageId" parameterType="Long" resultMap="MerchantGoodsImageResult">
        <include refid="selectMerchantGoodsImageVo"/>
        where merchant_goods_image_id = #{merchantGoodsImageId}
    </select>

    <select id="selectImagesByGoodsEvaluationId" resultType="GoodsEvaluationImage">
        SELECT * FROM goods_evaluation_image WHERE goods_evaluation_id = #{goodsEvaluationId} ORDER BY sort_order ASC
    </select>

    <insert id="insertMerchantGoodsImage" parameterType="MerchantGoodsImage">
        insert into merchant_goods_image
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantGoodsImageId != null">merchant_goods_image_id,</if>
            <if test="merchantGoodsId != null">merchant_goods_id,</if>
            <if test="imageUrl != null and imageUrl != ''">image_url,</if>
            <if test="imageDesc != null">image_desc,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="isMain != null">is_main,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantGoodsImageId != null">#{merchantGoodsImageId},</if>
            <if test="merchantGoodsId != null">#{merchantGoodsId},</if>
            <if test="imageUrl != null and imageUrl != ''">#{imageUrl},</if>
            <if test="imageDesc != null">#{imageDesc},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="isMain != null">#{isMain},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateMerchantGoodsImage" parameterType="MerchantGoodsImage">
        update merchant_goods_image
        <trim prefix="SET" suffixOverrides=",">
            <if test="merchantGoodsId != null">merchant_goods_id = #{merchantGoodsId},</if>
            <if test="imageUrl != null and imageUrl != ''">image_url = #{imageUrl},</if>
            <if test="imageDesc != null">image_desc = #{imageDesc},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="isMain != null">is_main = #{isMain},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where merchant_goods_image_id = #{merchantGoodsImageId}
    </update>

    <delete id="deleteMerchantGoodsImageByMerchantGoodsImageId" parameterType="Long">
        delete from merchant_goods_image where merchant_goods_image_id = #{merchantGoodsImageId}
    </delete>

    <delete id="deleteMerchantGoodsImageByMerchantGoodsImageIds" parameterType="String">
        delete from merchant_goods_image where merchant_goods_image_id in 
        <foreach item="merchantGoodsImageId" collection="array" open="(" separator="," close=")">
            #{merchantGoodsImageId}
        </foreach>
    </delete>
</mapper>