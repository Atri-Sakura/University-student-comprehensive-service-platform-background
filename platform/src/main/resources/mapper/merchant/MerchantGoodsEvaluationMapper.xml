<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.merchant.mapper.MerchantGoodsEvaluationMapper">

    <resultMap type="GoodsEvaluation" id="GoodsEvaluationResult">
        <result property="goodsEvaluationId"    column="goods_evaluation_id"    />
        <result property="merchantGoodsId"    column="merchant_goods_id"    />
        <result property="merchantBaseId"    column="merchant_base_id"    />
        <result property="userId"    column="user_id"    />
        <result property="orderId"    column="order_id"    />
        <result property="orderItemId"    column="order_item_id"    />
        <result property="rating"    column="rating"    />
        <result property="content"    column="content"    />
        <result property="isAnonymous"    column="is_anonymous"    />
        <result property="merchantReply"    column="merchant_reply"    />
        <result property="createTime"    column="create_time"    />
        <result property="replyTime"    column="reply_time"    />
        <result property="usefulCount"    column="useful_count"    />
    </resultMap>

    <!-- 查询商家门店评价列表，按星级和是否有图分类 -->
    <select id="selectGoodsEvaluationByMerchantAndRating" resultMap="GoodsEvaluationResult">
        SELECT * FROM goods_evaluation ge
        WHERE ge.merchant_base_id = #{merchantBaseId}
        <if test="category == null">
            <!-- 全部评价 -->
        </if>
        <if test="category == 5">
            AND ge.rating = 5
        </if>
        <if test="category == 4">
            AND ge.rating = 4
        </if>
        <if test="category == 3">
            AND ge.rating &lt;= 3
        </if>
        <if test="hasImage != null">
            <if test="hasImage == true">
                AND EXISTS (
                SELECT 1 FROM goods_evaluation_image gi WHERE gi.goods_evaluation_id = ge.goods_evaluation_id
                )
            </if>
            <if test="hasImage == false">
                AND NOT EXISTS (
                SELECT 1 FROM goods_evaluation_image gi WHERE gi.goods_evaluation_id = ge.goods_evaluation_id
                )
            </if>
        </if>
        ORDER BY ge.create_time DESC
    </select>

    <!-- 商家回复评价 -->
    <update id="replyGoodsEvaluation">
        UPDATE goods_evaluation
        SET merchant_reply = #{merchantReply}, reply_time = NOW()
        WHERE goods_evaluation_id = #{goodsEvaluationId}
    </update>
</mapper>